{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accounts.svc.plus/schemas/overlay/v1/gateway-snapshot.schema.json",
  "title": "XConnect-One Gateway Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "node_id",
    "generation",
    "expected_previous_generation",
    "issued_at",
    "expires_at",
    "proxy_core",
    "safety",
    "wireguard",
    "relay",
    "policy",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "$ref": "#/$defs/id" },
    "node_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 1 },
    "expected_previous_generation": { "type": "integer", "minimum": 0 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "proxy_core": { "const": "xray" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_empty_peers", "max_peer_removal_percent"],
      "properties": {
        "allow_empty_peers": { "type": "boolean" },
        "max_peer_removal_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_name", "listen_port", "addresses", "peers"],
      "properties": {
        "interface_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_=+.-]{1,15}$"
        },
        "listen_port": { "$ref": "#/$defs/port" },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cidr" }
        },
        "peers": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateway_peer" }
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "listen_host", "listen_port", "server_names", "credential_refs"],
      "properties": {
        "transport": { "const": "vless-tls-xudp" },
        "listen_host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "listen_port": { "$ref": "#/$defs/port" },
        "server_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "credential_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "backend", "ruleset_sha256"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "backend": { "const": "nftables" },
        "ruleset_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
    },
    "wg_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "gateway_peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "public_key", "allowed_ips"],
      "properties": {
        "device_id": { "$ref": "#/$defs/id" },
        "public_key": { "$ref": "#/$defs/wg_key" },
        "allowed_ips": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cidr" }
        },
        "persistent_keepalive_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 25
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}

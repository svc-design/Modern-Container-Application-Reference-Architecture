{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xconnect.one/schemas/v1/signed-config.schema.json",
  "title": "XConnect-One Signed Client Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "network_id",
    "device_id",
    "generation",
    "issued_at",
    "expires_at",
    "proxy_core",
    "transport",
    "wireguard",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "config_id": { "$ref": "#/$defs/id" },
    "network_id": { "$ref": "#/$defs/id" },
    "device_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "proxy_core": { "const": "xray" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "loopback", "remote", "auth_id"],
      "properties": {
        "kind": { "const": "vless-tls-xudp" },
        "loopback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": { "const": "127.0.0.1" },
            "port": { "$ref": "#/$defs/port" }
          }
        },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "server_name"],
          "properties": {
            "host": { "type": "string", "minLength": 1, "maxLength": 253 },
            "port": { "$ref": "#/$defs/port" },
            "server_name": { "type": "string", "minLength": 1, "maxLength": 253 }
          }
        },
        "auth_id": { "$ref": "#/$defs/id" }
      }
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_name", "addresses", "mtu", "peers"],
      "properties": {
        "interface_name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_=+.-]{1,15}$"
        },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cidr" }
        },
        "mtu": { "type": "integer", "minimum": 576, "maximum": 1500 },
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/client_peer" }
        }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
    },
    "wg_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "client_peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway_id", "public_key", "allowed_ips", "endpoint"],
      "properties": {
        "gateway_id": { "$ref": "#/$defs/id" },
        "public_key": { "$ref": "#/$defs/wg_key" },
        "allowed_ips": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cidr" }
        },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": { "const": "127.0.0.1" },
            "port": { "$ref": "#/$defs/port" }
          }
        },
        "persistent_keepalive_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 25
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}

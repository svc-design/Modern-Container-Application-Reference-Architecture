{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/device-session-mint-response.schema.json",
  "title": "XConnect-One short device session response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_nonce", "enrollment_token", "token_type", "issued_at", "expires_at", "scope", "device_id", "network_id", "signing_keys"],
  "properties": {
    "client_nonce": { "type": "string", "format": "uuid" },
    "enrollment_token": { "type": "string", "writeOnly": true, "pattern": "^xenr_" },
    "token_type": { "const": "Bearer" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["overlay:config:read", "overlay:config:ack"] },
      "allOf": [
        { "contains": { "const": "overlay:config:read" } },
        { "contains": { "const": "overlay:config:ack" } }
      ]
    },
    "device_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" },
    "network_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" },
    "signing_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" },
    "time": { "type": "string", "format": "date-time" },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key", "status", "not_before"],
      "properties": {
        "key_id": { "$ref": "#/$defs/id" },
        "algorithm": { "const": "Ed25519" },
        "public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
        "status": { "enum": ["current", "previous"] },
        "not_before": { "$ref": "#/$defs/time" },
        "not_after": { "$ref": "#/$defs/time" }
      }
    }
  }
}

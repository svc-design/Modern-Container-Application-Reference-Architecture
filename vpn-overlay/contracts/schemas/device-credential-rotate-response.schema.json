{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/device-credential-rotate-response.schema.json",
  "title": "XConnect-One device credential rotate response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_id", "replaces_credential_id", "token_type", "issued_at", "expires_at", "scope"],
  "properties": {
    "credential_id": { "type": "string", "pattern": "^xdcid_[0-9a-f]{32}$" },
    "replaces_credential_id": { "type": "string", "pattern": "^xdcid_[0-9a-f]{32}$" },
    "token_type": { "const": "Device" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["overlay:session:mint", "overlay:credential:rotate", "overlay:device:revoke"] },
      "allOf": [
        { "contains": { "const": "overlay:session:mint" } },
        { "contains": { "const": "overlay:credential:rotate" } },
        { "contains": { "const": "overlay:device:revoke" } }
      ]
    }
  }
}

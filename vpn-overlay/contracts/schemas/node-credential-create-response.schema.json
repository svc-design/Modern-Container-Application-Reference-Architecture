{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/node-credential-create-response.schema.json",
  "title": "XConnect-One node credential create response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential"],
  "properties": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_id", "bearer_token", "expires_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "node_id": { "$ref": "#/$defs/id" },
        "bearer_token": { "type": "string", "writeOnly": true, "pattern": "^xgn_" },
        "expires_at": { "$ref": "#/$defs/time" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" },
    "time": { "type": "string", "format": "date-time" }
  }
}

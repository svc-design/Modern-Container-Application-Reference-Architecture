{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accounts.svc.plus/schemas/overlay/v2/signed-config.schema.json",
  "title": "XConnect-One Signed Client Config v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config_id", "network_id", "device_id", "generation", "issued_at", "expires_at", "proxy_core", "transport", "wireguard", "policy", "signature"],
  "properties": {
    "schema_version": { "const": 2 },
    "config_id": { "$ref": "#/$defs/id" },
    "network_id": { "$ref": "#/$defs/id" },
    "device_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 1 },
    "issued_at": { "$ref": "#/$defs/time" },
    "expires_at": { "$ref": "#/$defs/time" },
    "proxy_core": { "const": "xray" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "loopback", "remote", "auth_id"],
      "properties": {
        "kind": { "const": "vless-tls-xudp" },
        "loopback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": { "const": "127.0.0.1" },
            "port": { "$ref": "#/$defs/port" }
          }
        },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "server_name"],
          "properties": {
            "host": { "type": "string", "minLength": 1, "maxLength": 253 },
            "port": { "$ref": "#/$defs/port" },
            "server_name": { "type": "string", "minLength": 1, "maxLength": 253 }
          }
        },
        "auth_id": { "$ref": "#/$defs/id" }
      }
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_name", "addresses", "mtu", "peers"],
      "properties": {
        "interface_name": { "type": "string", "pattern": "^[a-zA-Z0-9_=+.-]{1,15}$" },
        "addresses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/cidr" } },
        "mtu": { "type": "integer", "minimum": 576, "maximum": 1500 },
        "peers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/client_peer" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "digest", "path", "media_type"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "path": { "type": "string", "pattern": "^/api/overlay/v1/enrollment/policy-artifacts/[1-9][0-9]*/[a-f0-9]{64}$" },
        "media_type": { "const": "application/vnd.xconnect.policy.v1+json" }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "time": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$" },
    "wg_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
    "client_peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway_id", "public_key", "allowed_ips", "endpoint"],
      "properties": {
        "gateway_id": { "$ref": "#/$defs/id" },
        "public_key": { "$ref": "#/$defs/wg_key" },
        "allowed_ips": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/cidr" } },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": { "const": "127.0.0.1" },
            "port": { "$ref": "#/$defs/port" }
          }
        },
        "persistent_keepalive_seconds": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 25 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accounts.svc.plus/schemas/overlay/v1/policy-enforcement-artifact.schema.json",
  "title": "XConnect-One Policy Enforcement Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compiler_version", "network_id", "revision", "default_action", "protected_flows", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "compiler_version": {"const": "xconnect-acl-v1alpha1.1"},
    "network_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0},
    "default_action": {"const": "deny"},
    "protected_flows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "control:controller-session",
          "control:gateway-apply-result",
          "control:gateway-heartbeat",
          "control:gateway-policy-artifact",
          "control:gateway-snapshot"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "source_devices", "destination_devices", "protocols", "ports"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "action": {"enum": ["deny", "accept"]},
          "source_devices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/device_id"}},
          "destination_devices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/device_id"}},
          "protocols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["tcp", "udp", "icmp"]}},
          "ports": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
        }
      }
    }
  },
  "$defs": {
    "device_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$"}
  }
}

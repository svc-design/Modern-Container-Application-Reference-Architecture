{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/join-token-create-request.schema.json",
  "title": "XConnect-One one-time join create request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "network_id": { "$ref": "#/$defs/id" },
    "device_id": { "$ref": "#/$defs/id" },
    "platform": { "enum": ["darwin", "windows", "linux", "ios", "android"] },
    "expires_in_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "remaining_uses": { "type": "integer", "enum": [0, 1] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
  }
}

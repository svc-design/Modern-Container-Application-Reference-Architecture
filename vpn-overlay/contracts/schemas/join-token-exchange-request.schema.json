{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/join-token-exchange-request.schema.json",
  "title": "XConnect-One one-time join exchange request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["join_token", "device_id", "platform", "wireguard_public_key"],
  "properties": {
    "join_token": { "type": "string", "writeOnly": true, "pattern": "^xjt_" },
    "device_id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "maxLength": 255 },
    "platform": { "enum": ["darwin", "windows", "linux", "ios", "android"] },
    "hostname": { "type": "string", "maxLength": 255 },
    "wireguard_public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xconnect.one/schemas/v1/product-plugin-manifest.schema.json",
  "title": "XConnect Product Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "plugin_id",
    "display_name",
    "version",
    "host_api",
    "config_schema_version",
    "required_capabilities",
    "runtime_core_id",
    "delivery"
  ],
  "properties": {
    "manifest_schema_version": { "const": 1 },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "$ref": "#/$defs/semver" },
    "host_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum_exclusive"],
      "properties": {
        "minimum": { "$ref": "#/$defs/api_version" },
        "maximum_exclusive": { "$ref": "#/$defs/api_version" }
      }
    },
    "config_schema_version": { "type": "integer", "minimum": 1 },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "account.session",
          "secret.store",
          "tunnel.runtime",
          "network.controlled",
          "event.bus",
          "observability.logging",
          "observability.metrics",
          "diagnostics",
          "registration.cli-commands",
          "registration.ui-routes",
          "registration.tunnel-profiles"
        ]
      }
    },
    "runtime_core_id": { "const": "xray" },
    "delivery": { "const": "built-in" }
  },
  "$defs": {
    "api_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}

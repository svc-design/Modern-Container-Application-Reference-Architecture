{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/device-lifecycle-response.schema.json",
  "title": "XConnect-One device lifecycle response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["device", "duplicate"],
  "properties": {
    "revoked": { "type": "boolean" },
    "duplicate": { "type": "boolean" },
    "device": { "$ref": "#/$defs/device" },
    "policy_generation": { "type": "integer", "minimum": 1 },
    "policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_reconcile_pending": { "type": "boolean" }
  },
  "dependentRequired": {
    "policy_generation": ["policy_digest"],
    "policy_digest": ["policy_generation"]
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" },
    "timeOrNull": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user_id", "network_id", "name", "platform", "hostname", "wireguard_public_key", "wireguard_address", "created_at", "updated_at", "last_seen_at", "status", "state_version", "key_version", "revoked_at", "revoked_reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "user_id": { "type": "string", "format": "uuid" },
        "network_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 255 },
        "platform": { "enum": ["darwin", "windows", "linux", "ios", "android"] },
        "hostname": { "type": "string", "maxLength": 255 },
        "wireguard_public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
        "wireguard_address": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "last_seen_at": { "$ref": "#/$defs/timeOrNull" },
        "status": { "enum": ["active", "inactive", "revoked"] },
        "state_version": { "type": "integer", "minimum": 1 },
        "key_version": { "type": "integer", "minimum": 1 },
        "revoked_at": { "$ref": "#/$defs/timeOrNull" },
        "revoked_reason": { "type": "string", "maxLength": 512 }
      }
    }
  }
}

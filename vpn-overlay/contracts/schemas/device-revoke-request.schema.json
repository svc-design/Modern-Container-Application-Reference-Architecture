{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/device-revoke-request.schema.json",
  "title": "XConnect-One account-scoped device revoke request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["network_id", "expected_state_version"],
  "properties": {
    "network_id": { "$ref": "#/$defs/id" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "expected_state_version": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" }
  }
}

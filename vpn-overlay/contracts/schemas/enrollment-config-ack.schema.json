{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/enrollment-config-ack.schema.json",
  "title": "XConnect-One enrollment legacy config ACK v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "network_id", "revision", "digest", "applied_at"],
  "properties": {
    "device_id": { "$ref": "#/$defs/id" },
    "network_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "applied_at": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "time": { "type": "string", "format": "date-time" }
  }
}

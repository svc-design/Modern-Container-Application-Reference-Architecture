{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/static-client-import.schema.json",
  "title": "XConnect-One static Ansible client import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "network_id", "owner_user_id", "source", "devices"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "xconnect.accounts.static-client-import" },
    "network_id": { "$ref": "#/$defs/id" },
    "owner_user_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "variable", "baseline_sha256"],
      "properties": {
        "kind": { "const": "ansible-group-vars" },
        "variable": { "const": "xworkmate_bridge_distributed_vpn_clients" },
        "baseline_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/device" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "wireguard_public_key", "addresses", "tags", "attachments"],
      "properties": {
        "device_id": { "$ref": "#/$defs/id" },
        "wireguard_public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$" }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "contains": { "const": "migration:static-group-vars" },
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}

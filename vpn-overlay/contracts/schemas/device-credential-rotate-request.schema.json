{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.xconnect.one/contracts/v1/device-credential-rotate-request.schema.json",
  "title": "XConnect-One device credential rotate request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["new_credential_id", "new_credential_sha256"],
  "properties": {
    "new_credential_id": { "type": "string", "pattern": "^xdcid_[0-9a-f]{32}$" },
    "new_credential_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
